# Settings for the semantic API (copy to .env; .env is never committed). Every value has a default.
# TYPEDB_ADDRESS is TypeDB's HTTP port: host:port, or a full http:// or https:// address (TypeDB Cloud).
# Locally that is 127.0.0.1:8004 (compose.yaml publishes TypeDB's port 8000 there); inside Compose, http://typedb:8000.
TYPEDB_ADDRESS=127.0.0.1:8004
TYPEDB_USERNAME=admin
TYPEDB_PASSWORD=password
TYPEDB_DATABASE=vehicle
# Where the local server listens (server.ts); Docker sets API_HOST=0.0.0.0.
API_HOST=127.0.0.1
API_PORT=8000
