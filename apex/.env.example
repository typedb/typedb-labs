# Copy to .env and adjust if needed:  cp .env.example .env
# .env is git-ignored; never commit it.

# TypeDB connection: the HTTP endpoint, as host:port or an http(s):// origin. Apex has its own
# container whose HTTP port is published on 8003 (see compose.yaml); 1732 is the gRPC port, which
# the TypeScript API does not use. TypeDB Cloud: https://<cluster>.cloud.typedb.com:8000
TYPEDB_ADDRESS=127.0.0.1:8003
TYPEDB_USERNAME=admin
# TypeDB CE's built-in default password: acceptable only on this computer, with TypeDB
# reachable from this computer alone (compose.yaml binds it to 127.0.0.1).
TYPEDB_PASSWORD=password

# Which database the app reads. "apex" is the pristine demo data; "apex-demo" is the copy
# used for live demonstration steps (rebuild it with: cd api && npm run reset-demo).
APEX_DATABASE=apex
