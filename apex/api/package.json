{
  "name": "apex-api",
  "private": true,
  "version": "0.3.0",
  "description": "Project Apex: the read-only API over the fictional deal in TypeDB",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node --experimental-strip-types server.ts",
    "start": "node --experimental-strip-types server.ts",
    "gen": "node --experimental-strip-types scripts/gen.ts",
    "create-database": "node --experimental-strip-types scripts/create-database.ts",
    "reset-demo": "node --experimental-strip-types scripts/reset-demo.ts",
    "check-connection": "node --experimental-strip-types scripts/check-connection.ts",
    "export-seed-tql": "node --experimental-strip-types scripts/export-seed-tql.ts",
    "export-graph-sample": "node --experimental-strip-types scripts/export-graph-sample.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@typedb/driver-http": "3.14.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
